# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (MySQL / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peerlink

# Auth
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=1d

# Email (SMTP) - Required for password reset emails
# Example with Gmail (use an App Password, not your login password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=PeerLink <no-reply@peerlink.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
